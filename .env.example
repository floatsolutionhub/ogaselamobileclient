# Minutes of app inactivity/background time before the user is automatically logged out.
EXPO_PUBLIC_AUTO_LOGOUT_MINUTES=10

# Optional: social sign-in. A blank id keeps that button visible but answers "not available yet".
# The same Google client ids and Facebook app id must also be set on the API (Ogasela.API .env).
# Google OAuth client ids from Google Cloud Console - EXPO_PUBLIC_GOOGLE_CLIENT_ID is the web one.
EXPO_PUBLIC_GOOGLE_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
# Facebook Login app id (Meta for Developers). Native builds also need "fb<APP_ID>" added to
# expo.scheme in app.json so Facebook can redirect back into the app.
EXPO_PUBLIC_FACEBOOK_APP_ID=

# Ogasela.API base URL, including the /api/v1 prefix. localhost works for iOS simulator/Expo web;
# an Android emulator can't resolve the host machine's localhost - use http://10.0.2.2:8080/api/v1
# there instead. Point this at a real deployed URL for device/production builds.
EXPO_PUBLIC_API_URL=http://localhost:8080/api/v1

# Support channels shown by the floating support button (signed-in users). Leave either blank to
# hide that option. WhatsApp: a click-to-chat link, e.g. https://wa.me/2348012345678
EXPO_PUBLIC_SUPPORT_PHONE=
EXPO_PUBLIC_SUPPORT_WHATSAPP_URL=
